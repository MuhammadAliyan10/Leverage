# Public client endpoints. Replace these placeholders in your local .env or EAS environment.
# These endpoint values are visible in a built app; they are not credentials.
EXPO_PUBLIC_NEON_AUTH_URL=https://auth.example.invalid/neondb/auth
EXPO_PUBLIC_NEON_DATA_API_URL=https://data.example.invalid/neondb/rest/v1

# Required for production cloud authentication/sync. Use your HTTPS API origin.
# This example hostname is reserved and intentionally does not work.
EXPO_PUBLIC_MIZAN_API_URL=https://api.example.invalid

# Optional AI-specific origin; leave unset to reuse EXPO_PUBLIC_MIZAN_API_URL.
# EXPO_PUBLIC_AI_GATEWAY_URL=https://api.example.invalid
