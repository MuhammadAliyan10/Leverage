{
  "expo": {
    "name": "Leverage",
    "slug": "HouseLog",
    "description": "Understand and manage your money with Leverage.",
    "primaryColor": "#635BFF",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/leverage-icon-standard-v2.png",
    "scheme": "houselog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.anonymous.HouseLog"
    },
    "android": {
      "versionCode": 2,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#635BFF",
        "foregroundImage": "./assets/images/leverage-icon-standard-v2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.houselog.finance"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/leverage-icon-standard-v2.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#635BFF",
          "image": "./assets/images/leverage-icon-standard-v2.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "61392a1b-d326-4b6a-805a-7ddcc1416e79"
      }
    },
    "owner": "muhammadaliyan10"
  }
}
