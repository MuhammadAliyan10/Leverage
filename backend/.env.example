# Runtime application connection: Neon pooled endpoint, TLS required.
DATABASE_URL=postgresql://user:password@host-pooler.example/database?sslmode=require

# Prisma migrations only: Neon direct/unpooled endpoint, TLS required.
DATABASE_URL_UNPOOLED=postgresql://user:password@host.example/database?sslmode=require

# Generate with `openssl rand -base64 32`; keep server-side only.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=https://api.example.invalid
ALLOWED_ORIGINS=https://app.example.invalid
PORT=3001

# AI gateway trusts the app's Neon Auth Data API JWT, not BetterAuth cookies.
# Use the exact values returned by `neon env pull` for the same branch as the
# app. The JWKS URL is provided by Neon; do not construct or guess its path.
NEON_AUTH_BASE_URL=https://branch-auth-host.invalid/neondb/auth
NEON_AUTH_JWKS_URL=https://branch-auth-host.invalid/provider-issued-jwks-path
# 32-byte key encoded as 64 hex characters. Keep in the server secret manager, never in Expo.
# Generate with: openssl rand -hex 32
AI_CREDENTIAL_ENCRYPTION_KEY=
# Set only when the configured Neon Auth JWT contract has an `aud` claim.
# NEON_AUTH_AUDIENCE=provider-issued-audience
