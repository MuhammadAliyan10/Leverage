{
  "name": "mizan-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "start:production": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "test": "tsx --test tests/*.test.mjs"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.12",
    "@better-auth/prisma-adapter": "1.7.12",
    "@hono/node-server": "^1.19.11",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-auth": "1.7.12",
    "dotenv": "^16.6.1",
    "hono": "^4.12.5",
    "pg": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@electric-sql/pglite-socket": "^0.1.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "prisma": "7.9.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
